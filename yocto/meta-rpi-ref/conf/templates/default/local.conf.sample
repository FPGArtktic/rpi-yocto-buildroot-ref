# Raspberry Pi 4 (64-bit) reference configuration on Poky.
# Only what differs from meta-poky/conf/templates/default/local.conf.sample is commented.

MACHINE ??= "raspberrypi4-64"
DISTRO ?= "poky"

# Caches live next to the build directory, outside the source tree, so they survive
# `rm -rf build` and can be shared between container runtimes.
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"

# Serial console on the GPIO header.
ENABLE_UART = "1"

# WiFi/BT firmware for the Pi carries the Synaptics "killswitch" licence clause
# (meta-raspberrypi/docs/ipcompliance.md). It is not accepted here; the firmware is only
# recommended by the machine config, so the image builds without it. Accept it in your own
# local.conf if you need wireless:
#LICENSE_FLAGS_ACCEPTED = "synaptics-killswitch"

EXTRA_IMAGE_FEATURES ?= "debug-tweaks"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"

BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

CONF_VERSION = "2"
